{
  "name": "@ars/design-system-react",
  "version": "0.1.0",
  "description": "React wrappers for the ARS Design System — thin Radix UI primitives styled with the @ars/design-system CSS classes.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ars/design-system": "workspace:*",
    "@radix-ui/react-checkbox": ">=1.0.0",
    "@radix-ui/react-dialog": ">=1.0.0",
    "@radix-ui/react-dropdown-menu": ">=2.0.0",
    "@radix-ui/react-radio-group": ">=1.1.0",
    "@radix-ui/react-select": ">=2.0.0",
    "@radix-ui/react-switch": ">=1.0.0",
    "@radix-ui/react-tabs": ">=1.0.0",
    "@radix-ui/react-toast": ">=1.1.0",
    "@radix-ui/react-tooltip": ">=1.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@ars/design-system": "workspace:*",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "ars",
    "design-system",
    "react",
    "radix",
    "headless-ui",
    "components"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anselmo/ars-design-system.git",
    "directory": "react"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "restricted"
  },
  "sideEffects": false
}
